{
  "expo": {
    "name": "Kasse Church of Pentecost",
    "slug": "presence-attendance",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "kasse-cop",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0026A8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.presence.attendance",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Kasse Church of Pentecost needs the camera for attendance and member face registration.",
        "NSPhotoLibraryUsageDescription": "Kasse Church of Pentecost needs photo access to register member faces."
      }
    },
    "android": {
      "package": "com.presence.attendance",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0026A8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kasse Church of Pentecost to use your camera for attendance."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kasse Church of Pentecost to access photos for member face registration.",
          "cameraPermission": "Allow Kasse Church of Pentecost to use your camera for member face registration."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "apiUrl": "https://facial-attendance-system-wheat.vercel.app/api/v1",
      "eas": {
        "projectId": "094d9f7b-231a-4336-882f-005331fd6cb8"
      }
    },
    "owner": "katg"
  }
}
